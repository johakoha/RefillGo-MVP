# RefillGo MVP — Environment Variables Template
# Copy this file to a new file named .env and put in your real tokens / endpoints.
# Do NOT check in the .env file with real secrets/keys to your Git repository.

MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_TOKEN
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
